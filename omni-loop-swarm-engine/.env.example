# Copy to .env for local dev (python-dotenv is not wired in -- export these
# in your shell, or use `env $(cat .env | xargs) python app.py`).

# Port Flask/gunicorn binds to.
PORT=5000

# Never enable in production -- turns on the interactive debugger and
# auto-reload. Only for local development.
FLASK_DEBUG=false

# Comma-separated list of allowed origins, e.g. "https://app.example.com".
# Leave as "*" for the default single-container deployment (frontend and
# API served from the same origin -- CORS doesn't come into play at all).
# Only tighten this if you deploy the frontend separately from the API.
CORS_ORIGINS=*

# Fallback API keys, used when a request doesn't supply api_key in the
# body. All three providers require a key -- kilo/* included, despite the
# "free pool" name (its real endpoint returns 401 unauthenticated).
KILO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
